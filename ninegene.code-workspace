{
  // Shared ninegene VS Code workspace. Linked into the workspace root by
  // link-workspace.sh. Open it with: code ninegene.code-workspace
  // Recommended extensions live in .vscode/extensions.json.
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    // --- General ---------------------------------------------------------
    // Whitespace and line endings come from the shared .editorconfig.
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "editor.formatOnSave": true,
    "editor.rulers": [100],

    // Inline diagnostics (ErrorLens): errors and warnings only.
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],

    // Vim (vscodevim.vim)
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.leader": "<space>",

    // markdownlint rules live in the shared .markdownlint.json.
    "[markdown]": {
      "editor.wordWrap": "on",
    },

    // --- Bash ------------------------------------------------------------
    // shellcheck (timonwong.shellcheck) lints, shfmt formats using .editorconfig.
    "[shellscript]": {
      "editor.defaultFormatter": "mkhl.shfmt",
    },
    "shellcheck.enable": true,
    "shellcheck.run": "onType",
    // -x follows `source`d files.
    "shellcheck.customArgs": ["-x"],

    // --- JavaScript / TypeScript ----------------------------------------
    // Prettier only runs where a repo has its own Prettier config.
    "prettier.requireConfig": true,
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    // The workspace root holds many repos; find each repo's ESLint config.
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
    "[javascript][javascriptreact][typescript][typescriptreact]": {
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
      },
    },
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",

    // --- Python ----------------------------------------------------------
    // Ruff (charliermarsh.ruff) lints and formats; Pyright (ms-pyright.pyright)
    // type checks. Pylance is turned off so the two don't report duplicates.
    "python.languageServer": "None",
    "python.analysis.typeCheckingMode": "standard",
    "python.terminal.activateEnvironment": true,
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "explicit",
        "source.organizeImports.ruff": "explicit",
      },
      "editor.rulers": [88],
    },

    // --- Go --------------------------------------------------------------
    // gopls (golang.go) type checks; staticcheck adds extra analysis.
    "go.useLanguageServer": true,
    "gopls": {
      "ui.diagnostic.staticcheck": true,
    },
    "[go]": {
      "editor.defaultFormatter": "golang.go",
      "editor.insertSpaces": false,
      "editor.tabSize": 4,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
      },
    },
    "[go.mod][go.sum]": {
      "editor.insertSpaces": false,
    },

    // --- Elixir / Erlang -------------------------------------------------
    // ElixirLS formats with `mix format` and runs Dialyzer for type checking
    // (the first Dialyzer run builds a PLT and is slow).
    "elixirLS.dialyzerEnabled": true,
    "elixirLS.fetchDeps": false,
    "elixirLS.suggestSpecs": true,
    "[elixir]": {
      "editor.defaultFormatter": "JakeBecker.elixir-ls",
      "editor.insertSpaces": true,
      "editor.tabSize": 2,
      "editor.rulers": [98],
    },
    "[phoenix-heex]": {
      "editor.defaultFormatter": "phoenixframework.phoenix",
      "editor.insertSpaces": true,
      "editor.tabSize": 2,
    },
    "[erlang]": {
      "editor.insertSpaces": true,
      "editor.tabSize": 4,
    },
    "files.associations": {
      "*.heex": "phoenix-heex",
    },
    "emmet.includeLanguages": {
      "phoenix-heex": "html",
    },

    // --- Terraform -------------------------------------------------------
    // hashicorp.terraform provides the language server, formatting (`terraform fmt`)
    // and validation. Terraform files use 2-space indentation.
    "terraform.experimentalFeatures.validateOnSave": true,
    "[terraform][terraform-vars]": {
      "editor.defaultFormatter": "hashicorp.terraform",
      "editor.insertSpaces": true,
      "editor.tabSize": 2,
      "editor.codeActionsOnSave": {
        "source.formatAll.terraform": "explicit",
      },
    },
    "[terraform-stack][terraform-deploy]": {
      "editor.defaultFormatter": "hashicorp.terraform",
    },

    // --- Search and file watcher (fast across many repos) ----------------
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/package-lock.json": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/.pytest_cache": true,
      "**/_build": true,
      "**/deps": true,
      "**/.elixir_ls": true,
      "**/vendor": true,
      "**/.terraform": true,
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.git/objects/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true,
      "**/.ruff_cache/**": true,
      "**/_build/**": true,
      "**/deps/**": true,
      "**/.elixir_ls/**": true,
      "**/.terraform/**": true,
    },

    // Find the nested repos for Source Control.
    "git.repositoryScanMaxDepth": 2,
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Bootstrap dev environment (shared tools)",
        "type": "shell",
        "command": "./.github/bootstrap-dev-env.sh",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated" },
      },
      {
        "label": "Lint shell scripts (shellcheck + shfmt)",
        "type": "shell",
        "command": "shellcheck .github/*.sh && shfmt -d .github/*.sh",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "shared" },
      },
    ],
  },
}
